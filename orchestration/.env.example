# Linux/macOS: echo "AIRFLOW_UID=$(id -u)" >> orchestration/.env   (Windows: keep 50000)
AIRFLOW_UID=50000

# ── Cloud delivery (optional) ────────────────────────────────────────────────
# Filled from `make infra-outputs` after creating the AWS stack. Leave empty to keep
# the pipeline 100% local (the publish_to_cloud task becomes a no-op).
MODELS_BUCKET=
AWS_REGION=us-east-1
# Folder with your AWS CLI credentials, mounted read-only into Airflow
# (Windows example: C:/Users/<you>/.aws). Your IAM user needs ModelPublisherPolicyArn.
AWS_CONFIG_DIR=./aws
AWS_PROFILE=default
# repository_dispatch to start the CD when a new champion is published:
# fine-grained token with "Contents: Read and write" on the repository
GITHUB_REPOSITORY=
GITHUB_DISPATCH_TOKEN=

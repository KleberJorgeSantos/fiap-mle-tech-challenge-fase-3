# ── API ──────────────────────────────────────────────────────────────────────
# Inference backend: "onnx" (optimized, default) or "sklearn" (original baseline)
MODEL_BACKEND=onnx
MODEL_DIR=models
MAX_TEXT_LENGTH=20000
LOG_LEVEL=INFO

# ── MLflow ───────────────────────────────────────────────────────────────────
# Tracking server of docker-compose.yml. Leave unset to disable tracking.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT=triage-nlp
MLFLOW_REGISTERED_MODEL=triage-classifier

# ── Deploy (EC2) ─────────────────────────────────────────────────────────────
# Public URL used by Prometheus to build its links behind nginx
# PUBLIC_URL=http://<ip-ou-dominio-da-ec2>
# GRAFANA_ADMIN_PASSWORD=change-me

# ── Data ─────────────────────────────────────────────────────────────────────
DATA_DIR=data

# ── Network ──────────────────────────────────────────────────────────────────
# Networks with TLS inspection (corporate proxy / antivirus) need a custom CA bundle
# CA_BUNDLE=certs/ca-bundle.pem

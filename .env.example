# ── API ──────────────────────────────────────────────────────────────────────
# Inference backend: "onnx" (optimized, default) or "sklearn" (original baseline)
MODEL_BACKEND=onnx
MODEL_DIR=models
MAX_TEXT_LENGTH=20000
LOG_LEVEL=INFO

# ── MLflow ───────────────────────────────────────────────────────────────────
# Tracking server of orchestration/docker-compose.yml. Leave unset to disable tracking.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT=triage-nlp
MLFLOW_REGISTERED_MODEL=triage-classifier

# ── Cloud delivery (optional) ────────────────────────────────────────────────
# When set, `make train` also publishes the approved model to S3 and triggers the CD.
# MODELS_BUCKET=
# AWS_REGION=us-east-1
# GITHUB_REPOSITORY=owner/name
# GITHUB_DISPATCH_TOKEN=

# ── Data ─────────────────────────────────────────────────────────────────────
DATA_DIR=data

# ── Network ──────────────────────────────────────────────────────────────────
# Networks with TLS inspection (corporate proxy / antivirus) need a custom CA bundle
# CA_BUNDLE=certs/ca-bundle.pem
